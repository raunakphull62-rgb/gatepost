{
  "admin": {
    "listen": "127.0.0.1:2019"
  },
  "apps": {
    "http": {
      "servers": {
        "edge": {
          "listen": [
            ":80",
            ":443"
          ],
          "protocols": [
            "h1",
            "h2"
          ],
          "automatic_https": {
            "disable_redirects": true
          },
          "read_header_timeout": "10s",
          "read_timeout": "60s",
          "write_timeout": "60s",
          "idle_timeout": "2m",
          "max_header_bytes": 16384,
          "tls_connection_policies": [
            {
              "fallback_sni": "edge.invalid"
            }
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "static_response",
                  "status_code": "421",
                  "body": "Misdirected Request"
                }
              ]
            }
          ]
        }
      }
    },
    "tls": {
      "certificates": {
        "automate": [
          "edge.invalid"
        ]
      },
      "automation": {
        "policies": [
          {
            "issuers": [
              {
                "module": "internal"
              }
            ]
          }
        ]
      }
    }
  }
}