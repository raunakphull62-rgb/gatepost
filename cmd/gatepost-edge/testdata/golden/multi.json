{
  "admin": {
    "listen": "127.0.0.1:2019"
  },
  "apps": {
    "http": {
      "servers": {
        "edge": {
          "listen": [
            ":80",
            ":443"
          ],
          "protocols": [
            "h1",
            "h2"
          ],
          "automatic_https": {
            "disable_redirects": true
          },
          "read_header_timeout": "10s",
          "read_timeout": "60s",
          "write_timeout": "60s",
          "idle_timeout": "2m",
          "max_header_bytes": 16384,
          "tls_connection_policies": [
            {
              "fallback_sni": "edge.invalid"
            }
          ],
          "routes": [
            {
              "match": [
                {
                  "host": [
                    "api.customer-three.test"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "request_body",
                  "max_size": 33554432
                },
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "127.0.0.1:20103"
                    }
                  ],
                  "transport": {
                    "protocol": "http",
                    "dial_timeout": "10s",
                    "tls": {
                      "server_name": "api-origin.internal"
                    }
                  },
                  "headers": {
                    "request": {
                      "set": {
                        "Host": [
                          "api.customer-three.test"
                        ]
                      }
                    }
                  }
                }
              ]
            },
            {
              "match": [
                {
                  "host": [
                    "blog.customer-two.test"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "request_body",
                  "max_size": 33554432
                },
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "127.0.0.1:20102"
                    }
                  ],
                  "transport": {
                    "protocol": "http",
                    "dial_timeout": "10s",
                    "tls": {
                      "server_name": "shop-origin.internal"
                    }
                  },
                  "headers": {
                    "request": {
                      "set": {
                        "Host": [
                          "shop-origin.internal"
                        ]
                      }
                    }
                  }
                }
              ]
            },
            {
              "match": [
                {
                  "host": [
                    "shop.customer-two.test"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "request_body",
                  "max_size": 33554432
                },
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "127.0.0.1:20102"
                    }
                  ],
                  "transport": {
                    "protocol": "http",
                    "dial_timeout": "10s",
                    "tls": {
                      "server_name": "shop-origin.internal"
                    }
                  },
                  "headers": {
                    "request": {
                      "set": {
                        "Host": [
                          "shop.customer-two.test"
                        ]
                      }
                    }
                  }
                }
              ]
            },
            {
              "handle": [
                {
                  "handler": "static_response",
                  "status_code": "421",
                  "body": "Misdirected Request"
                }
              ]
            }
          ]
        }
      }
    },
    "tls": {
      "certificates": {
        "automate": [
          "edge.invalid"
        ]
      },
      "automation": {
        "on_demand": {
          "permission": {
            "module": "http",
            "endpoint": "http://127.0.0.1:8099/check"
          }
        },
        "policies": [
          {
            "subjects": [
              "edge.invalid"
            ],
            "issuers": [
              {
                "module": "internal"
              }
            ]
          },
          {
            "subjects": [
              "api.customer-three.test",
              "blog.customer-two.test",
              "shop.customer-two.test"
            ],
            "issuers": [
              {
                "module": "acme",
                "ca": "https://acme-staging-v02.api.letsencrypt.org/directory"
              }
            ],
            "on_demand": true
          }
        ]
      }
    },
    "pki": {
      "certificate_authorities": {
        "local": {
          "install_trust": false
        }
      }
    }
  }
}