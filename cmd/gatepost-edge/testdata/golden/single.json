{
  "admin": {
    "listen": "127.0.0.1:2019"
  },
  "apps": {
    "http": {
      "servers": {
        "edge": {
          "listen": [
            ":80",
            ":443"
          ],
          "protocols": [
            "h1",
            "h2"
          ],
          "automatic_https": {
            "disable_redirects": true
          },
          "read_header_timeout": "10s",
          "read_timeout": "60s",
          "write_timeout": "60s",
          "idle_timeout": "2m",
          "max_header_bytes": 16384,
          "logs": {},
          "tls_connection_policies": [
            {
              "fallback_sni": "edge.invalid"
            }
          ],
          "routes": [
            {
              "match": [
                {
                  "host": [
                    "www.customer-one.test"
                  ]
                }
              ],
              "handle": [
                {
                  "gatepost_origin": "http://origin-one.internal:8443",
                  "handler": "vars"
                },
                {
                  "handler": "request_body",
                  "max_size": 33554432
                },
                {
                  "handler": "log_append",
                  "key": "request_id",
                  "value": "{http.request.uuid}"
                },
                {
                  "handler": "log_append",
                  "key": "path",
                  "value": "{http.request.uri.path}"
                },
                {
                  "handler": "log_append",
                  "key": "user_agent",
                  "value": "{http.request.header.User-Agent}"
                },
                {
                  "handler": "log_append",
                  "key": "origin",
                  "value": "gatepost_origin"
                },
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "127.0.0.1:20101"
                    }
                  ],
                  "transport": {
                    "protocol": "http",
                    "dial_timeout": "10s"
                  },
                  "headers": {
                    "request": {
                      "set": {
                        "Host": [
                          "backend-one"
                        ]
                      }
                    }
                  }
                }
              ]
            },
            {
              "handle": [
                {
                  "handler": "log_append",
                  "key": "request_id",
                  "value": "{http.request.uuid}"
                },
                {
                  "handler": "log_append",
                  "key": "path",
                  "value": "{http.request.uri.path}"
                },
                {
                  "handler": "log_append",
                  "key": "user_agent",
                  "value": "{http.request.header.User-Agent}"
                },
                {
                  "handler": "log_append",
                  "key": "origin",
                  "value": "-"
                },
                {
                  "handler": "static_response",
                  "status_code": "421",
                  "body": "Misdirected Request"
                }
              ]
            }
          ]
        }
      }
    },
    "tls": {
      "certificates": {
        "automate": [
          "edge.invalid"
        ]
      },
      "automation": {
        "on_demand": {
          "permission": {
            "module": "http",
            "endpoint": "http://127.0.0.1:8099/check"
          }
        },
        "policies": [
          {
            "subjects": [
              "edge.invalid"
            ],
            "issuers": [
              {
                "module": "internal"
              }
            ]
          },
          {
            "subjects": [
              "www.customer-one.test"
            ],
            "issuers": [
              {
                "module": "acme",
                "ca": "https://acme-staging-v02.api.letsencrypt.org/directory"
              }
            ],
            "on_demand": true
          }
        ]
      }
    },
    "pki": {
      "certificate_authorities": {
        "local": {
          "install_trust": false
        }
      }
    }
  },
  "logging": {
    "logs": {
      "default": {
        "exclude": [
          "http.log.access"
        ]
      },
      "http.log.access": {
        "include": [
          "http.log.access"
        ],
        "writer": {
          "output": "file",
          "filename": "data/logs/access.json",
          "roll_size_mb": 10,
          "roll_keep": 5
        },
        "encoder": {
          "format": "filter",
          "wrap": {
            "format": "json"
          },
          "fields": {
            "request\u003eheaders": {
              "filter": "delete"
            },
            "request\u003euri": {
              "filter": "delete"
            },
            "resp_headers": {
              "filter": "delete"
            },
            "uuid": {
              "filter": "delete"
            }
          }
        }
      }
    }
  }
}