# Fault-injection poller image: same as Dockerfile.poller but compiled with
# the gatepost_edge_fault build tag so the WAF config-rejection fault hook is
# in. NEVER used in production — only for the config-rejection fallback test.
FROM golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -tags gatepost_edge_fault -o /out/gatepost-edge ./cmd/gatepost-edge

FROM alpine:3.21
RUN apk add --no-cache ca-certificates \
    && adduser -S -h /state edge \
    && mkdir -p /state && chown edge /state
COPY --from=build /out/gatepost-edge /usr/bin/gatepost-edge
USER edge
ENTRYPOINT ["/usr/bin/gatepost-edge"]
