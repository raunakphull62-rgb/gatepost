# Copy to .env (gitignored; never printed or committed). Fill both from Neon.
# DATABASE_URL = pooled connection string (Neon pooler, -pooler host) for the API.
# DATABASE_URL_DIRECT = direct connection string for migrations only.
# Local dev also works: any plain postgres:// URL in both (see scripts/).
DATABASE_URL=
DATABASE_URL_DIRECT=
# ENV: any value other than the exact string "development" is treated as
# production — prod/Production/empty all fail safe. Production refuses the
# outbox driver (bodies would be written to disk/db) and an http base URL.
ENV=development
# server
GP_HTTP_ADDR=127.0.0.1:8080
GP_PUBLIC_BASE_URL=http://localhost:8080
GP_MAIL_DRIVER=outbox
GP_MAIL_FROM=gatepost@localhost
# smtp (off unless GP_MAIL_DRIVER=smtp)
GP_SMTP_HOST=
GP_SMTP_PORT=
GP_SMTP_USER=
GP_SMTP_PASSWORD=
# oauth (needed only for real provider flow; tests use a fake provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# trusted proxy CIDRs, comma separated; default: trust nothing
GP_TRUSTED_PROXIES=
# rate limits (design §7): auth POSTs per IP per 15 min; failed-logins lockout
# per (IP, email) pair. Defaults 100 and 5.
GP_AUTH_CAP=100
GP_LOCKOUT_AFTER=5
