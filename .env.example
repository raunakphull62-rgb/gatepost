# Copy to .env (gitignored; never printed or committed). Fill both from Neon.
# DATABASE_URL = pooled connection string (Neon pooler, -pooler host) for the API.
# DATABASE_URL_DIRECT = direct connection string for migrations only.
# Local dev also works: any plain postgres:// URL in both (see scripts/).
DATABASE_URL=
DATABASE_URL_DIRECT=
# ENV: any value other than the exact string "development" is treated as
# production — prod/Production/empty all fail safe. Production refuses the
# outbox driver (bodies would be written to disk/db) and an http base URL.
ENV=development
# server
GP_HTTP_ADDR=127.0.0.1:8080
GP_PUBLIC_BASE_URL=http://localhost:8080
GP_MAIL_DRIVER=outbox
GP_MAIL_FROM=gatepost@localhost
# smtp (off unless GP_MAIL_DRIVER=smtp). TLS mode: "implicit" (port 465),
# "starttls" (port 587, default), "none" only for local throwaway relays —
# credentials are refused over unencrypted connections regardless.
GP_SMTP_HOST=
GP_SMTP_PORT=
GP_SMTP_TLS=
GP_SMTP_INSECURE= # true accepts self-signed relay certs (test/dev only)
GP_SMTP_USER=
GP_SMTP_PASSWORD=
# oauth (needed only for real provider flow; tests use a fake provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# domains (B2): per-user quotas — active claims and pending claims.
GP_DOMAIN_MAX=20
GP_DOMAIN_PENDING=5
# hostnames that belong to Gatepost itself: nobody may claim these
GP_SERVICE_HOSTNAMES=api.gatepost.net
# public recursive resolvers for ownership checks (TXT, later NS), 5s each
GP_DNS_RESOLVERS=1.1.1.1:53,8.8.8.8:53
# Gatepost-owned edge/API addresses: never valid origins (IPs or hostnames)
GP_OWNED_ADDRESSES=203.0.113.9
# TEST/DEMO ONLY: allow 127.0.0.1 and ::1 as origin addresses for local
# health-check demos. Production startup refuses to boot with this set true.
#GP_TEST_ALLOW_LOOPBACK=false
# trusted proxy CIDRs, comma separated (e.g. 10.0.0.0/8). Default: EMPTY —
# trust nothing, so every request's IP is the socket's remote address and any
# X-Forwarded-For header from a client is ignored.
GP_TRUSTED_PROXIES=
# rate limits (design §7): auth POSTs per IP per 15 min; failed-logins lockout
# per (IP, email) pair. Defaults 100 and 5.
GP_AUTH_CAP=100
GP_LOCKOUT_AFTER=5
